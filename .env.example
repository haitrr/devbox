# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Fine-grained PAT or classic token; gh reads this with no `gh auth login` step.
GH_TOKEN=

# Commit identity, written to ~/.gitconfig on every start. Without it every
# commit inside the box fails with "Author identity unknown" — agents included.
# Use the same values as your host so history stays consistent.
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional. GitHub's SSH host key is defaulted in docker-compose.yml; set this
# only to override it (e.g. if GitHub rotates the key before this repo updates).
# Format: one `github.com ssh-ed25519 AAAA...` line.
# GITHUB_KNOWN_HOSTS=

# Password for `sudo` inside the container (not for SSH — that stays key-only).
# Leave empty to disable sudo entirely; use `docker exec -u root devbox ...`
# for root work instead.
SUDO_PASSWORD=

# Long-lived Claude Code subscription token (sk-ant-oat01-...).
# Generate on the host with:  claude setup-token
# Requires a Pro, Max, Team, or Enterprise plan. Valid for one year.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Path to a markdown file copied to ~/.claude/CLAUDE.md on every
# start — global instructions Claude Code applies to every project in the box.
#     cp CLAUDE_box.example.md CLAUDE_box.md   # then uncomment the line below
# Leave it commented out until that file exists: Docker turns a bind-mount
# source that is missing into a directory, so pointing this at a file you have
# not created yet leaves a stray CLAUDE_box.md/ directory in the repo and
# installs nothing. CLAUDE_box.md is gitignored.
# CLAUDE_BOX_MD=./CLAUDE_box.md
